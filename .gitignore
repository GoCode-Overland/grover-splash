# Secrets. Bare `.env` alone is not enough: a sibling like `.env.bak` or
# `.env.local` slips straight past it and lands in `git status` as committable.
.env
.env.*
!.env.example
!.env.sample

# Stray copies that tend to appear next to a file being edited.
*.bak
*.backup
*.orig
*.save

.DS_Store
.vercel
node_modules/
dist/

# Generated by scripts/build-blog.js from content/blog/*.md — do not hand-edit.
# public/blog/blog.css stays tracked (shared stylesheet, not generated).
public/blog/*/
public/blog/index.html
public/sitemap.xml
.compound-engineering/*.local.yaml
